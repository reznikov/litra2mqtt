// homeassistant/light/logitech_MODEL-NAME/SERIAL-NUMBER/
{
  "~": "logitech/MODEL-NAME/SERIAL-NUMBER/",

  "device_class": "light",
  "unique_id": "/* serial number */",
  "supported_color_modes": [
    "color_temp"
  ],

  "device": {
    "name": null,
    "manufacturer": "Logitech",
    "model": "Litra Beam",
    "serial_number": "/* serial number */"
  },

//  "object_id": "/* serial number */",

  "availability_topic": "~/status",
  "state_topic": "~/power",
  "command_topic": "~/power/set",

  "brightness_scale": 400, // MAX - MIN
  "brightness_state_topic": "~/brightness",
  "brightness_command_topic": "~/brightness/set",

  "min_mireds": 153,
  "max_mireds": 370,
  "color_temp_state_topic": "~/color_temp",
  "color_temp_command_topic": "~/color_temp/set"

